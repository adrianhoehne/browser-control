# User-Unit, kein System-Dienst: die Bridge spricht mit dem Firefox des
# Betreibers, und der läuft in dessen Sitzung — nicht unter einem Systembenutzer.
#
# %h statt eines absoluten Pfades, weil INSTALL.md nach ~/browser-control klont.
# Die Unit kennt keinen Benutzernamen und muss kein Home raten.
#
# /usr/bin/env node statt eines fest verdrahteten Interpreterpfades: der wäre
# geraten. Eine nvm-Installation ist für User-Units unsichtbar — der minimale
# PATH kennt sie nicht, das Journal sagt dann "env: node: No such file". Wer kein
# node im Unit-PATH hat, trägt den absoluten Pfad hier oder in Environment=PATH=
# nach; INSTALL.md beschreibt den Handgriff, diese Datei rät ihn nicht.
#
# RestartPreventExitStatus=2: Exit 2 heißt "Tokendatei fehlt oder ist zu kurz".
# Das heilt kein Neustart. Ohne diese Zeile liefe eine 2-Sekunden-Schleife, die
# nur das Journal füllt und den eigentlichen Fehler in Rauschen begräbt.

[Unit]
Description=Browser bridge that exposes the operator's own Firefox as an MCP server

[Service]
Environment=BC_HTTP_PORT=8111
ExecStart=/usr/bin/env node %h/browser-control/bridge/bridge.mjs --http
Restart=on-failure
RestartSec=2
RestartPreventExitStatus=2
StandardError=journal

[Install]
WantedBy=default.target
