# User-Unit, kein System-Dienst: die Bridge spricht mit dem Firefox des
# Betreibers, und der läuft in dessen Sitzung — nicht unter einem Systembenutzer.
#
# %h statt eines absoluten Pfades, weil das Binary im Home des Betreibers liegt.
# Die Unit kennt keinen Benutzernamen und muss kein Home raten.
#
# ExecStart nennt das installierte Binary und keinen Interpreter: die Bridge ist
# ein statisch gelinktes Rust-Programm und braucht weder eine Laufzeitumgebung
# noch einen PATH-Eintrag, der sie findet. Wohin das Binary gehört, entscheidet
# `scripts/install.sh` (nach `~/.local/bin`, 0755); wer den Dienst ohne Installer
# aufsetzt, kopiert es selbst dorthin (bridge-rs/README.md, "Building").
#
# RestartPreventExitStatus=2: Exit 2 heißt "Tokendatei fehlt oder ist zu kurz".
# Das heilt kein Neustart. Ohne diese Zeile liefe eine 2-Sekunden-Schleife, die
# nur das Journal füllt und den eigentlichen Fehler in Rauschen begräbt.

[Unit]
Description=Browser bridge that exposes the operator's own Firefox as an MCP server

[Service]
Environment=BC_HTTP_PORT=8111
ExecStart=%h/.local/bin/browser-control-bridge --http
Restart=on-failure
RestartSec=2
RestartPreventExitStatus=2
StandardError=journal

[Install]
WantedBy=default.target
